    subgraph Resident Features
        ResDash --> ResQuickActions[Quick Actions]
        ResDash --> ResAnnouncements[Recent Announcements]
        ResDash --> ResRequests[My Requests Table]
        ResDash --> ResNav{Sidebar Navigation}
        
        ResNav --> Profile[resident/profile.php]
        ResNav --> ResReq[resident/requests.php]
        ResNav --> ResAppt[resident/appointments.php]
        ResNav --> ResAnnounce[resident/announcements.php]
        ResNav --> ResNotif[resident/notifications.php]
        ResNav --> ResQR[resident/qr.php]
        ResNav --> ResSettings[resident/settings.php]
    end
    
    subgraph Core Module Flows
        ResidentProfiling[Resident Profiling<br/>Tabbed Form] --> |Tab 1| PersonalInfo[Personal Information<br/>PCN, Name, Birth Date]
        ResidentProfiling --> |Tab 2| Demographics[Demographics<br/>Sex, Civil Status, Citizenship]
        ResidentProfiling --> |Tab 3| Location[Location & Housing<br/>Address, Purok, Materials]
        ResidentProfiling --> |Tab 4| SocioEconomic[Socio-Economic<br/>Education, Occupation, Income]
        ResidentProfiling --> |Tab 5| SpecialSectors[Special Sectors<br/>Checkboxes: Senior, PWD, etc.]
        
        PersonalInfo --> |Birth Date| AgeCalc[Auto-calculate Age<br/>PHP DateTime::diff]
        SpecialSectors --> |PWD Checked| PWDConditional[Show pwd_disability_type<br/>JavaScript toggle]
        SpecialSectors --> |Bulk Import| CSVImport[CSV/TSV/Paste Import<br/>Template Download]
        
        ApplicationFlow[Application Request<br/>7 Statuses] --> Submitted[submitted]
        Submitted --> Pending[pending]
        Pending --> UnderReview[under_review]
        UnderReview --> Approved[approved]
        Approved --> ReadyForPickup[ready_for_pickup]
        ReadyForPickup --> Completed[completed]
        UnderReview --> |Rejected| Rejected[rejected]
        
        Approved --> |Generate| DocGen[Document Generation<br/>10 Types + Auto-numbering]
        DocGen --> QRGen[QR Code Generation<br/>PHP GD Library]
        
        QRSystem[QR Verification System] --> Scanner[HTML5 QR Scanner]
        Scanner --> VerifyAPI[api/scan_handler.php]
        VerifyAPI --> LogVerification[verification_logs table<br/>IP + User Agent]
        
        AnnouncementFlow[Announcement System<br/>7 Types] --> |Publish| NotifyUsers[Create Notifications<br/>per targeted role]
        NotifyUsers --> |Resident reads| MarkRead[announcement_reads table]
    end
    
    AdminProfiling --> ResidentProfiling
    SecProfiling --> ResidentProfiling
    
    subgraph Security Layer
        CSRF[CSRF Protection<br/>csrfField/validateCsrfToken]
        RateLimit2[Login Rate Limiting<br/>5 attempts per 5 min]
        SessionTimeout[30-min Idle Timeout<br/>enforceSessionTimeout]
        AuditLog[Audit Logging<br/>logAudit - IP + UA]
        InputSanitize[Input Sanitization<br/>sanitizeString, validateEmail]
        PasswordHash[password_hash/verify<br/>Bcrypt]
    end
    
    LoginForm --> CSRF
    LoginForm --> RateLimit2
    

        AdminNav --> |Surveillance| AdminQR[scanner/index.php]
        AdminNav --> |Surveillance| AdminCCTV[admin/cctv.php]
        AdminNav --> |System| AdminUsers[admin/users.php]
        AdminNav --> |System| AdminReports[admin/reports.php]
        AdminNav --> |System| AdminLogs[admin/logs.php]
        AdminNav --> |System| AdminBackup[admin/backup.php]
        AdminNav --> |System| AdminSettings[admin/settings.php]
    end
    

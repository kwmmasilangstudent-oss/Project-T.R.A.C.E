flowchart TD
    Start((User Visits Site)) --> Landing[Landing Page<br/>landing/home.php]
    
    Landing --> |Click Login| AuthChoice{Login Method?}
    AuthChoice --> |Email/Password| LoginForm[auth/login.php]
    AuthChoice --> |Google OAuth| GoogleLogin[auth/google_login.php]
    
    LoginForm --> |POST| CSRF1{CSRF Valid?}
    CSRF1 --> |No| LoginError[Show Error]
    CSRF1 --> |Yes| RateLimit{Rate Limit?}
    RateLimit --> |5 attempts/5min| RateError[Show Error]
    RateLimit --> |Pass| ValidateCreds{Email & Password<br/>Match?}
    ValidateCreds --> |No| LoginError
    ValidateCreds --> |Yes| SessionSetup[Regenerate Session<br/>Store user_id, role, name]
    
    GoogleLogin --> GoogleCallback[auth/google_callback.php]
    GoogleCallback --> |Exchange Code| GetGoogleInfo[Fetch Google Profile]
    GetGoogleInfo --> LinkOrCreate{Account Exists?}
    LinkOrCreate --> |Yes| LinkGoogle[Link google_id to user]
    LinkOrCreate --> |No| CreateResident[Create new resident account]
    LinkGoogle --> SessionSetup
    CreateResident --> SessionSetup
    
    SessionSetup --> MainRouter[index.php<br/>Role Router]
    
    MainRouter --> |admin| AdminDash[admin/dashboard.php]
    MainRouter --> |secretary| SecDash[secretary/dashboard.php]
    MainRouter --> |resident| ResDash[resident/dashboard.php]
    MainRouter --> |not logged in| Landing
    
    subgraph Admin Features
        AdminDash --> AdminStats[Charts & Stats<br/>Chart.js]
        AdminDash --> AdminNav{Sidebar Navigation}
        
        AdminNav --> |People & Records| AdminResidents[admin/residents.php]
        AdminNav --> |People & Records| AdminProfiling[admin/resident_profiling.php<br/>Full CRUD + Tabs]
        AdminNav --> |People & Records| AdminOfficials[admin/officials.php]

    subgraph Theme System
        ThemePref[User theme_preference<br/>light / dark / system]
        SystemPref[OS prefers-color-scheme]
        LightClass[html.light class]
        DarkClass[html.dark class]
        CSSVars[CSS Custom Properties<br/>:root overrides]
        
        ThemePref --> |light| LightClass
        ThemePref --> |dark| DarkClass
        ThemePref --> |system| SystemPref
        SystemPref --> |light| LightClass
        SystemPref --> |dark| DarkClass
        LightClass --> CSSVars
        DarkClass --> CSSVars
        CSSVars --> |Updates| Sidebar[sb-wrap background]
        CSSVars --> |Updates| Cards[glass-card colors]
        CSSVars --> |Updates| Inputs[form controls]
        CSSVars --> |Updates| Tables[table styles]
        CSSVars --> |Updates| Modals[modal backgrounds]
    end
    
    SessionSetup --> |Reads| ThemePref
    Header[includes/header.php] --> |Applies| LightClass
    Footer[includes/footer.php] --> |Contains| CSSVars
    
